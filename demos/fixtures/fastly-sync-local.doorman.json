{
  "$schema": "https://doorman.griffen.codes/schema.json",
  "version": "2.0",
  "provider": "fastly",
  "providers": {
    "fastly": { "workspaceId": "workspace_demo" }
  },
  "rules": [
    {
      "id": "rule_block_bad_bots",
      "name": "Block Bad Bots",
      "enabled": true,
      "conditions": [{ "field": "user_agent", "operator": "contains", "value": "bot", "group": 0 }],
      "conditionLogic": "AND",
      "action": { "type": "block" }
    },
    {
      "id": "rule_block_admin_access",
      "name": "Block Admin Access",
      "enabled": true,
      "conditions": [{ "field": "path", "operator": "contains", "value": "/admin", "group": 0 }],
      "conditionLogic": "AND",
      "action": { "type": "block" }
    }
  ],
  "ips": [
    { "ip": "198.51.100.7", "action": "deny" },
    { "ip": "203.0.113.9", "action": "deny" }
  ]
}
